# ============================================================================
# HL7 FHIR Transformer — Environment Variables
# ============================================================================
# Copy this file to .env and fill in production values.
# NEVER commit the .env file to version control.
# ============================================================================

# --- Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- MongoDB ---
MONGODB_URI=mongodb://admin:CHANGE_ME@localhost:27017/admin?authSource=admin

# --- RabbitMQ ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- API Keys (one per integration tenant) ---
API_KEY_TENANT1=CHANGE_ME_GENERATE_UUID
API_KEY_DEMO=CHANGE_ME_GENERATE_UUID

# --- Logging ---
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
